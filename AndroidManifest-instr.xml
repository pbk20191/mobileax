<?xml version="1.0" encoding="utf-8"?>
<!-- Installed and run via `am instrument`; there is no launchable component. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Package visibility: adopted shell permissions don't widen what an
         app uid can see, and apps/links/pm/install must see every package. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <instrumentation
        android:name="dev.mobileax.daemon.MobaxInstrumentation"
        android:targetPackage="dev.mobileax.daemon" />
</manifest>
