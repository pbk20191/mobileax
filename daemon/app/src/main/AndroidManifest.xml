<?xml version="1.0" encoding="utf-8"?>
<!-- Run by app_process (pushed, not installed) or installed as the package
     its androidTest APK instruments; there is no launchable component. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Package visibility: adopted shell permissions don't widen what an
         app uid can see, and apps/links/pm/install must see every package. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- No icon in the launcher, so the label is how Settings › Apps names it:
         a stray copy (a host that never ran `mobax drop`) can be found and removed. -->
    <application android:hasCode="true" android:label="mobileAX daemon" />
</manifest>
